{
  "name": "hermes-agent",
  "version": "0.17.6",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "build:frontend": "cd apps/frontend && npm run build",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "install:all": "npm install && cd apps/frontend && npm install",
    "clean": "npm run clean --workspaces",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.0",
  "packages": {
    "ui": {
      "devDependencies": {
        "@hermes/eslint-config": "file:../eslint-config",
        "@hermes/prettier-config": "file:../prettier-config",
        "@hermes/shared-types": "file:../shared-types"
      }
    }
  },
  "overrides": {
    "@carbon/icons-react": "11.88.0",
    "@carbon/ibmdotcom-styles": "2.57.3",
    "@carbon/react": "1.117.0"
  }
}
